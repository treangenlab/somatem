#!/usr/bin/env bash
set -euo pipefail

PIPELINE_DIR="@@PIPELINE_DIR@@"

show_help() {
    cat <<EOF
Somatem

Usage:
  somatem <command> [nextflow args...]

Commands:
  full_name (short_name)        Description
  pre_processing                Run the main pipeline with pre-processing analysis
  16S                           Run 16S taxonomic profiling (sets data_type to 16S and analysis_type to taxonomic-profiling)
  taxonomic_profiling (tax)     Run taxonomic profiling (defaults to metagenomic data)
  assembly_mags (mag)           Run the main pipeline with assembly analysis
  genome_dynamics (dynamics)    Run the main pipeline with genome dynamics analysis
  download_example_data (examples) Download example datasets, including sample sheets and config yaml files
  pre_download_databases (dbs)     Download required databases based on config file
  help                          Show this help message

Common shortcuts:
  -i, --input            Input sample sheet CSV
  -o, --outdir           Output directory
  -data, --data_type     Data type (16S, isolate or metagenomic)
  -params, --params-file Parameters file documenting other options used in the pipeline
  -resume                Resume the last run. Resuming named run with -resume run_name not yet supported

Examples:
  somatem 16S -i samples.csv -o results
  somatem taxonomic_profiling -i samples.csv -o results
  somatem taxonomic_profiling --data_type 16S -i samples.csv -o results
  somatem assembly_mags -i samples.csv -o results
  somatem genome_dynamics -i samples.csv -o results
  somatem download_example_data
  somatem pre_download_databases

Defaults:
  defaults to --data_type = metagenomic for taxonomic_profiling

Input CSV format:
  sample,fastq_1
  mock1,assets/examples/data/16S/mockm95_sub10k.fastq.gz
  mock2,assets/examples/data/16S/mockm91_sub10k.fastq.gz
EOF
}

resolve_args() {
    RESOLVED_ARGS=()
    HAS_DATA_TYPE=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--input)
                shift
                RESOLVED_ARGS+=("--input" "$1")
                ;;
            -o|--outdir)
                shift
                RESOLVED_ARGS+=("--outdir" "$1")
                ;;
            -data|--data_type)
                shift
                HAS_DATA_TYPE=1
                RESOLVED_ARGS+=("--data_type" "$1")
                ;;
            -params|--params-file)
                shift
                pf="$1"
                if [[ "$pf" != /* && -f "${PIPELINE_DIR}/${pf}" ]]; then
                    RESOLVED_ARGS+=("-params-file" "${PIPELINE_DIR}/${pf}")
                # default to metagenomic data type if not specified
                else
                    RESOLVED_ARGS+=("-params-file" "$pf")
                fi
                ;;
            *)
                RESOLVED_ARGS+=("$1")
                ;;
        esac
        shift
    done
}

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

resolve_args "$@"

case "${cmd}" in
    16S|16s)
        exec nextflow run "${PIPELINE_DIR}/main.nf" \
            --data_type 16S \
            --analysis_type taxonomic-profiling \
            "${RESOLVED_ARGS[@]}"
        ;;
    pre_processing|pre-processing|preprocessing)
        exec nextflow run "${PIPELINE_DIR}/main.nf" \
            --analysis_type pre-processing \
            "${RESOLVED_ARGS[@]}"
        ;;
    assembly_mags|mag_assembly|mag|assembly)
        exec nextflow run "${PIPELINE_DIR}/main.nf" \
            --analysis_type assembly \
            "${RESOLVED_ARGS[@]}"
        ;;
    taxonomic_profiling|taxonomic-profiling|tax|profiling)
        if [[ "${HAS_DATA_TYPE}" -eq 1 ]]; then
            exec nextflow run "${PIPELINE_DIR}/main.nf" \
                --analysis_type taxonomic-profiling \
                "${RESOLVED_ARGS[@]}"
        else
            exec nextflow run "${PIPELINE_DIR}/main.nf" \
                --data_type metagenomic \
                --analysis_type taxonomic-profiling \
                "${RESOLVED_ARGS[@]}"
        fi
        ;;
    genome_dynamics|genome-dynamics|dynamics)
        exec nextflow run "${PIPELINE_DIR}/main.nf" \
            --analysis_type genome-dynamics \
            "${RESOLVED_ARGS[@]}"
        ;;
    download_example_data|get_example_data|examples)
        exec nextflow run "${PIPELINE_DIR}/subworkflows/local/download_example_datasets.nf" \
            -c "${PIPELINE_DIR}/nextflow.config" \
            "${RESOLVED_ARGS[@]}"
        ;;
    pre_download_databases|pre-download-databases|databases|dbs)
        exec nextflow run "${PIPELINE_DIR}/subworkflows/local/utils/pre_download_databases.nf" \
            -c "${PIPELINE_DIR}/nextflow.config" \
            "${RESOLVED_ARGS[@]}"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Error: unknown command '${cmd}'" >&2
        echo >&2
        show_help >&2
        exit 1
        ;;
esac