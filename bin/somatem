#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
    SOURCE_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    if [[ "${SOURCE}" != /* ]]; then
        SOURCE="${SOURCE_DIR}/${SOURCE}"
    fi
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"

# Keep Nextflow environments and micromamba's package cache with the Somatem
# installation instead of writing large caches below the user's home directory.
# Explicit user overrides always take precedence.
SOMATEM_INSTALL_PREFIX="$(cd "${SCRIPT_DIR}/.." && pwd)"
SOMATEM_DEFAULT_HOME="${SOMATEM_INSTALL_PREFIX}/share/somatem"
SOMATEM_STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/somatem"
SOMATEM_EXAMPLE_PATH_FILE="${SOMATEM_STATE_DIR}/example_data_dir"
export NXF_CONDA_CACHEDIR="${NXF_CONDA_CACHEDIR:-${SOMATEM_CONDA_CACHE:-${SOMATEM_HOME:-${SOMATEM_DEFAULT_HOME}}/conda_cache}}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-${SOMATEM_HOME:-${SOMATEM_DEFAULT_HOME}}/micromamba}"

NEXTFLOW_BIN="nextflow"
if [[ -x "${SCRIPT_DIR}/nextflow" ]]; then
    NEXTFLOW_BIN="${SCRIPT_DIR}/nextflow"
fi
export PATH="${SCRIPT_DIR}:${PATH}"

PIPELINE_DIR="@@PIPELINE_DIR@@"
PIPELINE_DIR_PLACEHOLDER="@""@PIPELINE_DIR@""@"
if [[ "${PIPELINE_DIR}" == "${PIPELINE_DIR_PLACEHOLDER}" ]]; then
    PIPELINE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
export SOMATEM_PIPELINE_DIR="${PIPELINE_DIR}"

run_nextflow() {
    local script="$1"
    shift

    if [[ ! -f "${script}" ]]; then
        echo "Error: cannot find Nextflow script: ${script}" >&2
        exit 1
    fi

    exec "${NEXTFLOW_BIN}" run "${script}" "$@"
}

require_main_nextflow() {
    local version major minor

    version="$(${NEXTFLOW_BIN} -version 2>/dev/null | awk '/version/ { print $2; exit }')"
    major="${version%%.*}"
    minor="${version#*.}"
    minor="${minor%%.*}"

    if [[ -z "${version}" || -z "${major}" || -z "${minor}" ]]; then
        echo "Error: could not determine Nextflow version." >&2
        exit 1
    fi

    if (( major < 26 )); then
        cat >&2 <<EOF
Error: this Somatem main workflow requires Nextflow >=26.0.0, but found ${version}.

Utility commands such as 'download_example_data' can still run with older Nextflow.
Update Nextflow, then re-run this command.
EOF
        exit 1
    fi
}

show_help() {
    cat <<EOF
somatem - A modular and open source metagenomic analysis toolkit designed for long reads.

Usage:
  somatem <command> [nextflow args...]

Commands:
  pre_processing                Run the main pipeline with pre-processing analysis
  16S                           Run 16S taxonomic profiling (sets data_type to 16S and analysis_type to taxonomic-profiling)
  taxonomic_profiling (tax)     Run taxonomic profiling (defaults to metagenomic data)
  assembly_mags (mag)           Run the main pipeline with assembly analysis
  isolate_analysis (isolate)    Run isolate assembly, classification, annotation, and typing
  seqscreen                     Run SeqScreen pathogen detection from FASTA inputs
  genome_dynamics (dynamics)    Run the main pipeline with genome dynamics analysis
  download_example_data (examples) Download example datasets, including sample sheets and config yaml files
  pre_download_databases (dbs)     Download required databases based on config file
  help                             Show this help message

Common shortcuts:
  -i, --input            Input sample sheet CSV
  -o, --outdir           Output directory
  -t, --threads          Total CPU budget; high-tier tasks use approximately 90%
  -data, --data_type     Data type (16S, isolate or metagenomic)
  --taxonomic_profiler   Metagenomic classifier: sylph (default), lemur-magnet, kraken2, or singlem
  --sylph_taxonomic_group Sylph database: prokaryotic (default), viral, fungal, or all
  --sylph_db             Custom Sylph .syldb file (overrides --sylph_taxonomic_group)
  -params, --params_file Parameters file documenting other options used in the pipeline
  -resume                Resume the last run. Resuming named run with -resume run_name not yet supported

Example data location:
  A successful 'somatem examples --outdir PATH' is remembered automatically.
  Set SOMATEM_EXAMPLE_DIR to override the remembered location.

Examples:
  somatem examples
  somatem 16S -o results
  somatem taxonomic_profiling -o results
  somatem taxonomic_profiling -i samples.csv -o results --taxonomic_profiler kraken2 --kraken2_db /path/to/db
  somatem taxonomic_profiling -i samples.csv -o results --sylph_taxonomic_group viral
  somatem taxonomic_profiling -i samples.csv -o results --sylph_db /path/to/custom.syldb
  somatem taxonomic_profiling --data_type 16S -i samples.csv -o results
  somatem assembly_mags -i samples.csv -o results
  somatem isolate_analysis -i samples.csv -o results
  somatem seqscreen -i samples.csv -o results --seqscreen_db /path/to/SeqScreenDB_23.4
  somatem genome_dynamics -i samples.csv -o results
  somatem download_example_data -o ./assets
  somatem pre_download_databases -o ./assets/dbs

Input CSV format:
  sample,fastq_1
  mock1,assets/data/16S/mockm95_sub10k.fastq.gz
  mock2,assets/data/16S/mockm91_sub10k.fastq.gz

SeqScreen input CSV format:
  sample,fasta
  sample1,assets/data/other_tools_files/more_files/seqscreen/10_seqs.fasta
EOF
}

resolve_args() {
    RESOLVED_ARGS=()
    HAS_DATA_TYPE=0
    HAS_OUTDIR=0
    HAS_INPUT=0
    HAS_PARAMS_FILE=0
    OUTDIR_VALUE=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--input)
                shift
                HAS_INPUT=1
                RESOLVED_ARGS+=("--input" "$1")
                ;;
            -o|--outdir)
                shift
                HAS_OUTDIR=1
                OUTDIR_VALUE="$1"
                RESOLVED_ARGS+=("--outdir" "$1")
                ;;
            -t|--threads)
                shift
                if [[ ! "${1:-}" =~ ^[0-9]+$ || "$1" -lt 1 ]]; then
                    echo "Error: --threads requires a positive integer." >&2
                    exit 1
                fi
                RESOLVED_ARGS+=("--threads" "$1")
                ;;
            -data|--data_type)
                shift
                HAS_DATA_TYPE=1
                RESOLVED_ARGS+=("--data_type" "$1")
                ;;
            -params|--params_file)
                shift
                HAS_PARAMS_FILE=1
                pf="$1"
                if [[ "$pf" != /* && -f "${PIPELINE_DIR}/${pf}" ]]; then
                    RESOLVED_ARGS+=("-params-file" "${PIPELINE_DIR}/${pf}")
                # default to metagenomic data type if not specified
                else
                    RESOLVED_ARGS+=("-params-file" "$pf")
                fi
                ;;
            *)
                RESOLVED_ARGS+=("$1")
                ;;
        esac
        shift
    done
}

use_example_input_by_default() {
    if [[ "${HAS_INPUT}" -eq 0 && "${HAS_PARAMS_FILE}" -eq 0 ]]; then
        local example_dir="${SOMATEM_EXAMPLE_DIR:-}"
        if [[ -z "${example_dir}" && -f "${SOMATEM_EXAMPLE_PATH_FILE}" ]]; then
            example_dir="$(<"${SOMATEM_EXAMPLE_PATH_FILE}")"
        fi
        if [[ -z "${example_dir}" ]]; then
            example_dir="${PIPELINE_DIR}/assets"
        fi
        if [[ ! -f "${example_dir}/samplesheets/$1" ]]; then
            echo "Error: example sample sheet not found: ${example_dir}/samplesheets/$1" >&2
            echo "Run 'somatem examples --outdir PATH' first or set SOMATEM_EXAMPLE_DIR." >&2
            exit 1
        fi
        RESOLVED_ARGS+=("--input" "${example_dir}/samplesheets/$1")
    fi
}

run_example_download() {
    local example_dir="$1"
    shift

    "${NEXTFLOW_BIN}" run "${PIPELINE_DIR}/subworkflows/local/download_example_datasets.nf" \
        -c "${PIPELINE_DIR}/nextflow.config" "$@"

    mkdir -p "${SOMATEM_STATE_DIR}"
    printf '%s\n' "${example_dir}" > "${SOMATEM_EXAMPLE_PATH_FILE}"
    echo "Example data location saved: ${example_dir}"
}

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

resolve_args "$@"

case "${cmd}" in
    16S|16s)
        require_main_nextflow
        use_example_input_by_default "16S_pilot_samples.csv"
        run_nextflow "${PIPELINE_DIR}/main.nf" \
            --data_type 16S \
            --analysis_type taxonomic-profiling \
            "${RESOLVED_ARGS[@]}"
        ;;
    pre_processing|pre-processing|preprocessing)
        require_main_nextflow
        run_nextflow "${PIPELINE_DIR}/main.nf" \
            --analysis_type pre-processing \
            "${RESOLVED_ARGS[@]}"
        ;;
    assembly_mags|mag_assembly|mag|assembly)
        require_main_nextflow
        use_example_input_by_default "mag_samples.csv"
        run_nextflow "${PIPELINE_DIR}/main.nf" \
            --analysis_type assembly \
            "${RESOLVED_ARGS[@]}"
        ;;
    isolate_analysis|isolate-analysis|isolate)
        require_main_nextflow
        use_example_input_by_default "isolate_samples.csv"
        run_nextflow "${PIPELINE_DIR}/main.nf" \
            --data_type isolate \
            --analysis_type isolate-analysis \
            "${RESOLVED_ARGS[@]}"
        ;;
    seqscreen|pathogen_detection|pathogen-detection)
        require_main_nextflow
        use_example_input_by_default "seqscreen_samples.csv"
        if [[ "${HAS_OUTDIR}" -eq 0 ]]; then
            RESOLVED_ARGS+=("--outdir" "seqscreen_results")
        fi
        run_nextflow "${PIPELINE_DIR}/main.nf" \
            --analysis_type seqscreen \
            "${RESOLVED_ARGS[@]}"
        ;;
    taxonomic_profiling|taxonomic-profiling|tax|profiling)
        require_main_nextflow
        use_example_input_by_default "meta_tax_samples.csv"
        if [[ "${HAS_DATA_TYPE}" -eq 1 ]]; then
            run_nextflow "${PIPELINE_DIR}/main.nf" \
                --analysis_type taxonomic-profiling \
                "${RESOLVED_ARGS[@]}"
        else
            run_nextflow "${PIPELINE_DIR}/main.nf" \
                --data_type metagenomic \
                --analysis_type taxonomic-profiling \
                "${RESOLVED_ARGS[@]}"
        fi
        ;;
    genome_dynamics|genome-dynamics|dynamics)
        require_main_nextflow
        use_example_input_by_default "timeseries_samples.csv"
        run_nextflow "${PIPELINE_DIR}/main.nf" \
            --analysis_type genome-dynamics \
            "${RESOLVED_ARGS[@]}"
        ;;
    download_example_data|download-example-data|get_example_data|get-example-data|example_data|examples)
        if [[ "${HAS_OUTDIR}" -eq 0 ]]; then
            OUTDIR_VALUE="${PIPELINE_DIR}/assets"
            RESOLVED_ARGS+=("--outdir" "${OUTDIR_VALUE}")
        fi
        if [[ "${OUTDIR_VALUE}" != /* ]]; then
            OUTDIR_VALUE="$(pwd)/${OUTDIR_VALUE}"
        fi
        run_example_download "${OUTDIR_VALUE}" "${RESOLVED_ARGS[@]}"
        ;;
    pre_download_databases|pre-download-databases|download_databases|download-databases|databases|dbs)
        run_nextflow "${PIPELINE_DIR}/subworkflows/local/utils/pre_download_databases.nf" \
            -c "${PIPELINE_DIR}/nextflow.config" \
            "${RESOLVED_ARGS[@]}"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Error: unknown command '${cmd}'" >&2
        echo >&2
        show_help >&2
        exit 1
        ;;
esac
