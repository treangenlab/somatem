/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Somatem Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

params.somatem_detected_cpus = Runtime.runtime.availableProcessors() as int
params.somatem_detected_memory_gb = new File("/proc/meminfo").exists() ? new File("/proc/meminfo").readLines().find { line -> line.startsWith("MemTotal:") }.tokenize()[1].toLong().intdiv(1024 * 1024) as int : 100
params.somatem_max_cpus = (params.threads ?: params.max_cpus ?: Math.max(1, (params.somatem_detected_cpus as int) - 1)) as int
params.somatem_max_memory_gb = (params.max_memory_gb ?: Math.max(1, (params.somatem_detected_memory_gb as int) - (params.local_memory_reserve_gb as int))) as int
params.somatem_low_cpus = params.threads ? Math.max(1, Math.ceil((params.somatem_max_cpus as int) / 6.0) as int) : Math.min(2, params.somatem_max_cpus as int)
params.somatem_medium_cpus = params.threads ? Math.max(1, Math.ceil((params.somatem_max_cpus as int) / 2.0) as int) : Math.min(6, params.somatem_max_cpus as int)
params.somatem_high_cpus = params.threads ? Math.max(1, Math.floor((params.somatem_max_cpus as int) * 0.9) as int) : Math.min(12, params.somatem_max_cpus as int)

process {

    // Local resource limits; --threads is the preferred CPU budget. --max_cpus
    // remains supported for direct Nextflow use and backwards compatibility.
    resourceLimits = [
        cpus: params.somatem_max_cpus,
        memory: params.somatem_max_memory_gb.GB,
        time: 72.h
    ]


    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used by several vendored DSL2 modules.
    //        Keeping the same label naming convention makes local modules easier to tune.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { Math.min((params.somatem_low_cpus as int) * task.attempt, params.somatem_max_cpus as int) }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { Math.min((params.somatem_medium_cpus as int) * task.attempt, params.somatem_max_cpus as int) }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { params.somatem_high_cpus as int }
        memory = { Math.min(72 * task.attempt, params.somatem_max_memory_gb as int).GB }
        time   = { 16.h }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}
