/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Somatem Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

params.somatem_detected_cpus = Runtime.runtime.availableProcessors()
params.somatem_detected_memory_mib = java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize().intdiv(1024 * 1024)
params.somatem_detected_memory_gb = params.somatem_detected_memory_mib.intdiv(1024) as int
params.somatem_max_cpus = (params.threads ?: params.max_cpus ?: Math.max(1, (params.somatem_detected_cpus as int) - 1)) as int
params.somatem_max_memory_gb = (params.max_memory_gb ?: Math.max(1, (params.somatem_detected_memory_gb as int) - (params.local_memory_reserve_gb as int))) as int

// A local executor shares one batch allocation. Grid tasks get their own allocations.
params.somatem_slurm_cpus = (env('SLURM_CPUS_PER_TASK') ?: env('SLURM_CPUS_ON_NODE') ?: 0) as int
params.somatem_local_cpus = ({
    if (!params.somatem_slurm_cpus) return params.somatem_max_cpus
    def available = Math.min(params.somatem_slurm_cpus as int, params.somatem_detected_cpus as int)
    return Math.min(available, (params.threads ?: params.max_cpus ?: available) as int)
}())
params.somatem_local_memory = ({
    def perNode = env('SLURM_MEM_PER_NODE')
    def perCpu = env('SLURM_MEM_PER_CPU')
    if (!perNode && !perCpu) return params.somatem_max_memory_gb.GB
    def allocationMiB = perNode ? perNode.toLong() : perCpu.toLong() * ((params.somatem_slurm_cpus ?: 1) as int)
    def availableMiB = params.somatem_detected_memory_mib as long
    if (allocationMiB > 0) availableMiB = Math.min(availableMiB, allocationMiB)  // --mem=0 requests the whole node
    def budgetMiB = params.max_memory_gb
        ? (params.max_memory_gb as long) * 1024
        : availableMiB - (params.local_memory_reserve_gb as long) * 1024
    return Math.min(availableMiB, Math.max(1024L, budgetMiB)).MB
}())

// resourceLimits caps each task; the local executor must also budget concurrent tasks.
params.somatem_budget_local_executor = params.analysis_type in ['isolate-analysis', 'seqscreen'] || env('SLURM_JOB_ID') != null
executor {
    cpus = params.somatem_budget_local_executor ? params.somatem_local_cpus : null
    memory = params.somatem_budget_local_executor ? params.somatem_local_memory : null
}

process {

    ext.somatem_cpu_limit = { task.executor == 'local' ? params.somatem_local_cpus : params.somatem_max_cpus }
    ext.somatem_memory_limit = { task.executor == 'local' ? params.somatem_local_memory : params.somatem_max_memory_gb.GB }
    ext.somatem_scaled_cpus = { params.threads || (task.executor == 'local' && params.somatem_slurm_cpus) ? task.ext.somatem_cpu_limit : 0 }
    resourceLimits = {
        [cpus: task.ext.somatem_cpu_limit, memory: task.ext.somatem_memory_limit, time: 72.h]
    }

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Sample failures must not cancel unrelated isolates. Shared database downloads
    // run outside this workflow; shared MOB initialization and the report stay fatal.
    withName: '(.*:)?ISOLATE_ANALYSIS:(?!(ISOLATE_ANALYSIS_SUMMARY_REPORT|MOB_SUITE_DATABASE_INIT)).*' {
        errorStrategy = {
            task.exitStatus in ((130..145) + 104 + 175) && task.attempt <= task.maxRetries ? 'retry' : 'ignore'
        }
        maxRetries = 1
        maxErrors = -1
    }

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used by several vendored DSL2 modules.
    //        Keeping the same label naming convention makes local modules easier to tune.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = {
            def cpus = task.ext.somatem_scaled_cpus ? Math.ceil(task.ext.somatem_scaled_cpus / 6.0) as int : 2
            return Math.min(cpus * task.attempt, task.ext.somatem_cpu_limit as int)
        }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        ext.somatem_medium_cpus = { task.ext.somatem_scaled_cpus ? Math.ceil(task.ext.somatem_scaled_cpus / 2.0) as int : Math.min(6, task.ext.somatem_cpu_limit as int) }
        cpus   = { Math.min(task.ext.somatem_medium_cpus * task.attempt, task.ext.somatem_cpu_limit as int) }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // Whole-assembly alignments can exceed the medium estimate. Keep other
    // local tasks off the allocation while either SeqScreen index is in use.
    withName: 'SEQSCREEN_BOWTIE2' {
        cpus = { task.attempt == 1 ? task.ext.somatem_medium_cpus : 1 }
        memory = { task.executor == 'local' ? params.somatem_local_memory : 36.GB * task.attempt }
    }
    withLabel:process_high {
        cpus   = { task.ext.somatem_scaled_cpus ? Math.max(1, Math.floor(task.ext.somatem_scaled_cpus * 0.9) as int) : Math.min(12, task.ext.somatem_cpu_limit as int) }
        memory = { [72.GB * task.attempt, task.ext.somatem_memory_limit].min() }
        time   = { 16.h }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}
